# ==============================================================
#  BasketBest — Environment Variables
#  File: .env.example
#
#  1. Copy this file:   cp .env.example .env.local
#  2. Fill in every value (see dashboard guide below)
#  3. NEVER commit .env.local to Git
#     Add to .gitignore:  .env.local
# ==============================================================


# --------------------------------------------------------------
#  SUPABASE — PostgreSQL (Prisma runtime via PgBouncer)
#
#  📍 WHERE TO FIND:
#     Supabase Dashboard → Your Project
#     → Project Settings (gear icon, left sidebar)
#     → Database
#     → Connection string
#     → Select mode: "Transaction" (for pooled/PgBouncer)
#     → Copy the URI — it looks like:
#        postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
#  ⚠️  Append  ?pgbouncer=true  at the end — required for Prisma
# --------------------------------------------------------------

DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"


# --------------------------------------------------------------
#  SUPABASE — PostgreSQL Direct Connection (Prisma migrations)
#
#  📍 WHERE TO FIND:
#     Supabase Dashboard → Your Project
#     → Project Settings (gear icon, left sidebar)
#     → Database
#     → Connection string
#     → Select mode: "Session" (direct, not pooled)
#     → Copy the URI — it looks like:
#        postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
#
#  ℹ️  Used only by `prisma migrate` and `prisma db push`.
#     Never used at runtime — safe to leave out in production
#     if you run migrations from a dev/CI environment only.
# --------------------------------------------------------------

DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"


# --------------------------------------------------------------
#  UPSTASH — Redis (rate limiting, caching, scrape job queues)
#
#  📍 WHERE TO FIND:
#     Upstash Console → console.upstash.com
#     → Select your Redis database (or click "Create Database")
#     → Scroll to "REST API" section  ← use this, NOT the Redis URL
#       OR
#     → Click "Connect" → choose "@upstash/redis" tab
#     → Copy the UPSTASH_REDIS_REST_URL value
#
#  ⚠️  Upstash provides two kinds of URLs:
#      • redis://...   — standard Redis protocol (ioredis, etc.)
#      • https://...   — REST API (serverless / Edge-safe ✅)
#     For Next.js Edge Runtime / Vercel, always use the REST URL.
# --------------------------------------------------------------

UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-TOKEN]"


# --------------------------------------------------------------
#  APP — Public base URL
#
#  📍 WHERE TO SET:
#     Local dev  →  http://localhost:3000  (always)
#     Vercel     →  Vercel Dashboard → Project → Settings
#                   → Environment Variables → add this key
#                   → Value: https://your-app.vercel.app
#                   (or your custom domain if configured)
#
#  ℹ️  The NEXT_PUBLIC_ prefix exposes this to the browser bundle.
#     Never put secrets behind NEXT_PUBLIC_.
# --------------------------------------------------------------

NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ==============================================================
#  QUICK REFERENCE — Variable → Dashboard Path
#
#  DATABASE_URL   supabase.com → Project → Settings → Database
#                 → Connection string → Mode: Transaction
#
#  DIRECT_URL     supabase.com → Project → Settings → Database
#                 → Connection string → Mode: Session
#
#  UPSTASH_REDIS_REST_URL    console.upstash.com → Your DB
#                            → REST API → UPSTASH_REDIS_REST_URL
#
#  UPSTASH_REDIS_REST_TOKEN  console.upstash.com → Your DB
#                            → REST API → UPSTASH_REDIS_REST_TOKEN
#
#  NEXT_PUBLIC_APP_URL       Set manually. localhost:3000 for dev,
#                            your domain for prod.
# ==============================================================
